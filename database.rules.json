{
  "rules": {
    "rooms": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('hostId').val() === auth.uid || data.child('players').child(auth.uid).exists())",
        "players": {
          "$playerId": {
            ".write": "auth != null && auth.uid === $playerId"
          }
        },
        "status": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid"
        },
        "trackId": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid"
        }
      }
    }
  }
}
